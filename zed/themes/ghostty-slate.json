{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Ghostty Slate",
  "author": "gian.gg",
  "themes": [
    {
      "name": "Ghostty Slate",
      "appearance": "dark",
      "style": {
        "background.appearance": "blurred",
        "background": "#0F11148C",

        "border": "#D2D0CC0D",
        "border.variant": "#D2D0CC0A",
        "border.focused": "#D2D0CC1F",
        "border.selected": "#D2D0CC1F",
        "border.transparent": "#00000000",
        "border.disabled": "#D2D0CC08",
        "pane_group.border": "#D2D0CC0D",

        "surface.background": "#00000000",
        "elevated_surface.background": "#15181CF2",
        "panel.background": "#00000000",
        "panel.focused_border": "#00000000",
        "status_bar.background": "#00000000",
        "title_bar.background": "#00000000",
        "title_bar.inactive_background": "#00000000",
        "toolbar.background": "#00000000",
        "tab_bar.background": "#00000000",
        "tab.inactive_background": "#00000000",
        "tab.active_background": "#D2D0CC0A",
        "editor.background": "#00000000",
        "editor.gutter.background": "#00000000",
        "editor.subheader.background": "#00000000",
        "terminal.background": "#00000000",
        "drop_target.background": "#2B303680",

        "element.background": "#D2D0CC0A",
        "element.hover": "#D2D0CC0F",
        "element.active": "#D2D0CC18",
        "element.selected": "#2B3036CC",
        "element.disabled": "#00000000",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#D2D0CC0F",
        "ghost_element.active": "#D2D0CC18",
        "ghost_element.selected": "#2B3036CC",
        "ghost_element.disabled": "#00000000",

        "text": "#D2D0CC",
        "text.muted": "#B8B6B2",
        "text.placeholder": "#5A5958",
        "text.disabled": "#5A5958",
        "text.accent": "#A9B4C2",
        "icon": "#B4B2AE",
        "icon.muted": "#7B7A78",
        "icon.disabled": "#5A5958",
        "icon.placeholder": "#5A5958",
        "icon.accent": "#A9B4C2",

        "scrollbar.thumb.background": "#D2D0CC14",
        "scrollbar.thumb.hover_background": "#D2D0CC26",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "editor.foreground": "#D2D0CC",
        "editor.active_line.background": "#D2D0CC08",
        "editor.highlighted_line.background": "#D2D0CC0A",
        "editor.line_number": "#4A4D52",
        "editor.active_line_number": "#D2D0CC",
        "editor.invisible": "#3A3D42",
        "editor.wrap_guide": "#D2D0CC08",
        "editor.active_wrap_guide": "#D2D0CC10",
        "editor.indent_guide": "#D2D0CC0A",
        "editor.indent_guide_active": "#D2D0CC1A",
        "editor.document_highlight.read_background": "#2B303680",
        "editor.document_highlight.write_background": "#2B3036B0",
        "editor.document_highlight.bracket_background": "#2B3036B0",
        "search.match_background": "#A9B4C233",

        "terminal.foreground": "#D2D0CC",
        "terminal.bright_foreground": "#E6E3DE",
        "terminal.dim_foreground": "#7B7A78",
        "terminal.ansi.black": "#1C1F23",
        "terminal.ansi.bright_black": "#4A4D52",
        "terminal.ansi.red": "#D49A9A",
        "terminal.ansi.bright_red": "#E4AEAE",
        "terminal.ansi.green": "#A3BC9E",
        "terminal.ansi.bright_green": "#BBD2B5",
        "terminal.ansi.yellow": "#CDBE92",
        "terminal.ansi.bright_yellow": "#DDCFA6",
        "terminal.ansi.blue": "#9DADC6",
        "terminal.ansi.bright_blue": "#B2C0D6",
        "terminal.ansi.magenta": "#BBA2BE",
        "terminal.ansi.bright_magenta": "#CDB5D0",
        "terminal.ansi.cyan": "#93BABA",
        "terminal.ansi.bright_cyan": "#AACECE",
        "terminal.ansi.white": "#D2D0CC",
        "terminal.ansi.bright_white": "#E6E3DE",

        "status_bar.foreground": "#7B7A78",
        "title_bar.foreground": "#7B7A78",

        "error": "#D49A9A",
        "warning": "#CDBE92",
        "info": "#9DADC6",
        "hint": "#7B7A78",
        "success": "#A3BC9E",
        "created": "#A3BC9E",
        "modified": "#CDBE92",
        "deleted": "#D49A9A",
        "conflict": "#D49A9A",
        "ignored": "#8A8986",
        "hidden": "#8A8986",

        "players": [
          {
            "cursor": "#D2D0CC",
            "background": "#D2D0CC",
            "selection": "#2B3036E6"
          }
        ],

        "syntax": {
          "keyword": { "color": "#A9B4C2" },
          "function": { "color": "#C9C2B4" },
          "variable": { "color": "#D2D0CC" },
          "variable.special": { "color": "#CDBE92" },
          "property": { "color": "#C2C0BC" },
          "type": { "color": "#93BABA" },
          "constructor": { "color": "#93BABA" },
          "constant": { "color": "#BBA2BE" },
          "boolean": { "color": "#BBA2BE" },
          "string": { "color": "#A3BC9E" },
          "string.escape": { "color": "#CDBE92" },
          "string.regex": { "color": "#CDBE92" },
          "number": { "color": "#C7AE96" },
          "operator": { "color": "#8E959E" },
          "punctuation": { "color": "#7B7A78" },
          "punctuation.bracket": { "color": "#8E959E" },
          "comment": { "color": "#5F6268", "font_style": "italic" },
          "comment.doc": { "color": "#6E7177", "font_style": "italic" },
          "tag": { "color": "#D49A9A" },
          "attribute": { "color": "#BBA2BE" },
          "label": { "color": "#A9B4C2" },
          "link_text": { "color": "#93BABA" },
          "link_uri": { "color": "#9DADC6" },
          "emphasis": { "color": "#D2D0CC", "font_style": "italic" },
          "emphasis.strong": { "color": "#E6E3DE", "font_weight": 700 },
          "title": { "color": "#E6E3DE", "font_weight": 700 }
        }
      }
    }
  ]
}
