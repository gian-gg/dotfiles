{
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "vim_mode": true,
  "show_edit_predictions": false,
  "agent": {
    "dock": "right",
    "default_model": {
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5"
    },
    "model_parameters": []
  },
  "relative_line_numbers": "enabled",
  "gutter": {
    "min_line_number_digits": 2,
    "line_numbers": true
  },
  "languages": {
    "Assembly": {
      "show_edit_predictions": false
    },
    "C++": {
      "show_edit_predictions": false
    },
    "C": {
      "show_edit_predictions": false
    }
  },
  "icon_theme": "Catppuccin Latte Monochrome",
  "auto_update_extensions": {
    "discord-presence": false
  },
  "ui_font_family": "Dank Mono",
  "buffer_font_family": "Dank Mono",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte (Blur)",
    "dark": "Ghostty Slate"
  },
  "project_panel": {
    "dock": "right"
  },
  "buffer_font_features": {
    "calt": false,
    "liga": false,
    "dlig": false
  },
  "hide_mouse": "on_typing_and_movement",
  "terminal": {
    "font_family": "Dank Mono",
    "font_size": 16,
    "font_features": {
      "calt": false,
      "liga": false,
      "dlig": false
    },
    "option_as_meta": true,
    "line_height": "standard",
    "toolbar": {
      "breadcrumbs": false
    }
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "tabs": {
    "file_icons": false,
    "git_status": false
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false
  },
  "title_bar": {
    "show_branch_icon": false,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false
  },
  "scrollbar": {
    "show": "auto",
    "git_diff": false,
    "selected_text": false,
    "selected_symbol": false,
    "search_results": false,
    "diagnostics": "none",
    "cursors": false
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "fixed"
  }
}
