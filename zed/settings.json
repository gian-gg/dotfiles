{
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "vim_mode": true,
  "show_edit_predictions": false,
  "agent": {
    "dock": "right",
    "default_model": {
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5"
    },
    "model_parameters": []
  },
  "relative_line_numbers": "enabled",
  "gutter": {
    "min_line_number_digits": 2,
    "line_numbers": true
  },
  "languages": {
    "Assembly": {
      "show_edit_predictions": false
    },
    "C++": {
      "show_edit_predictions": false
    },
    "C": {
      "show_edit_predictions": false
    }
  },
  "icon_theme": "Catppuccin Latte Monochrome",
  "auto_update_extensions": {
    "discord-presence": false
  },
  "ui_font_family": "Dank Mono",
  "buffer_font_family": "Dank Mono",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte (Blur)",
    "dark": "Catppuccin Espresso (Blur)"
  },
  "project_panel": {
    "dock": "right"
  },
  "experimental.theme_overrides": {
    "background.appearance": "blurred"
  },
  "buffer_font_features": {
    "liga": false
  }
}
