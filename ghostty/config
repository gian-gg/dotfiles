term = xterm-256color

# macOS window vibe (clean, minimal, “poster frame”)
macos-titlebar-style = hidden
window-decoration = true
window-save-state = always

# icon styling (hex WITHOUT '#')
macos-icon = xray
macos-icon-frame = plastic
macos-icon-ghost-color = 7B7A78
macos-icon-screen-color = 0E0F11

# Font
font-family = "Dank Mono"
font-thicken = true
font-size = 16
font-feature = -calt, -liga, -dlig

mouse-hide-while-typing = true

# --- Colors: foggy slate + paper highlights (hex WITHOUT '#') ---
background = 0F1114
background-opacity = 0.72
background-blur-radius = 22

foreground = D2D0CC
cursor-color = D2D0CC

selection-background = 2B3036
selection-foreground = E6E3DE

# Padding
window-padding-x = 22
window-padding-y = 22

# --- Keybinds ---
keybind = global:cmd+f20=toggle_quick_terminal
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top
keybind = ctrl+l=goto_split:right

keybind = cmd+h=previous_tab
keybind = cmd+l=next_tab

keybind = super+ctrl+h=resize_split:left,10
keybind = super+ctrl+j=resize_split:down,10
keybind = super+ctrl+k=resize_split:up,10
keybind = super+ctrl+l=resize_split:right,10
