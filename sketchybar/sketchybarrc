# TUI Bar - SketchyBar Config
# Transparent bar with bracketed TUI segments
# Version 3.1 | February 2026

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### TUI Color Palette #####
# Warm terminal tones with high-contrast text

# Primary - White emphasis
PRIMARY=0xffffffff
PRIMARY_FG=0xff1f1e1c

# Background Layers - Transparent bar
BG_BASE=0x00000000      # Transparent
BG_CARD=0x992b2a27      # Segment background (lower opacity)

# Foreground Colors
FG_PRIMARY=0xffded8cf   # Warm off-white
FG_MUTED=0xffb6b0a6     # Muted gray
BORDER=0x553c3833       # Subtle border (alpha)

##### Bar Appearance - TUI #####
# Transparent bar background with bracketed segments

sketchybar --bar \
  position=top \
  height=36 \
  margin=8 \
  y_offset=6 \
  corner_radius=0 \
  border_width=0 \
  blur_radius=0 \
  padding_left=12 \
  padding_right=12 \
  color=$BG_BASE \
  shadow=off \
  sticky=on \
  topmost=false \
  notch_width=200

##### Changing Defaults - TUI #####
# Monospace typography with compact spacing
# Brackets provide the TUI frame (no segment backgrounds)

default=(
  padding_left=8
  padding_right=8
  icon.font="JetBrains Mono:Regular:13.0"
  label.font="JetBrains Mono:Regular:12.0"
  icon.color=$FG_PRIMARY
  label.color=$FG_PRIMARY
  icon.padding_left=8
  icon.padding_right=6
  label.padding_left=6
  label.padding_right=8
  background.height=28
  background.corner_radius=0
  background.border_width=0
  background.border_color=$BORDER
  background.drawing=off
  background.padding_left=0
  background.padding_right=0
  background.color=$BG_CARD
  background.shadow.drawing=off
  updates=on
)

sketchybar --default "${default[@]}"

# ============================================================
# Left

# Apple Logo
sketchybar --add item apple.logo left \
  --set apple.logo \
  icon.drawing=off \
  label="[ 􀣺 ]" \
  label.color=$PRIMARY \
  label.font="SF Pro:Bold:12.0" \
  label.padding_left=8 \
  label.padding_right=10 \
  background.drawing=off \
  click_script="open -a 'System Settings'"

# Apple Separator
sketchybar --add item apple.separator left \
  --set apple.separator \
  icon.drawing=off \
  label="/" \
  label.color=$FG_MUTED \
  label.font="JetBrains Mono:Regular:12.0" \
  label.padding_left=6 \
  label.padding_right=6 \
  background.drawing=off

##### Aerospace Workspace Prompt #####
# Format: {active_spaces} | {spaces_with_apps}
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_monitor_change

sketchybar --add item aerospace.lbracket left \
  --set aerospace.lbracket \
  icon.drawing=off \
  label="[" \
  label.color=$FG_MUTED \
  label.font="JetBrains Mono:Regular:12.0" \
  label.padding_left=10 \
  label.padding_right=4 \
  background.drawing=off

sketchybar --add item aerospace.active left \
  --set aerospace.active \
  icon.drawing=off \
  label.color=$PRIMARY \
  label.font="JetBrains Mono:Bold:12.0" \
  label.padding_left=4 \
  label.padding_right=4 \
  background.drawing=off \
  update_freq=5 \
  script="$CONFIG_DIR/plugins/aerospace_prompt.sh" \
  --subscribe aerospace.active aerospace_workspace_change aerospace_monitor_change

sketchybar --add item aerospace.sep left \
  --set aerospace.sep \
  icon.drawing=off \
  label="|" \
  label.color=$FG_MUTED \
  label.font="JetBrains Mono:Regular:12.0" \
  label.padding_left=4 \
  label.padding_right=4 \
  background.drawing=off

sketchybar --add item aerospace.occupied left \
  --set aerospace.occupied \
  icon.drawing=off \
  label.color=$FG_PRIMARY \
  label.font="JetBrains Mono:Regular:12.0" \
  label.padding_left=4 \
  label.padding_right=4 \
  background.drawing=off

sketchybar --add item aerospace.rbracket left \
  --set aerospace.rbracket \
  icon.drawing=off \
  label="]" \
  label.color=$FG_MUTED \
  label.font="JetBrains Mono:Regular:12.0" \
  label.padding_left=4 \
  label.padding_right=10 \
  background.drawing=off

# Front app
sketchybar --add item front_app left \
  --set front_app \
  icon.drawing=off \
  label.drawing=on \
  label.font="JetBrains Mono:Regular:12.0" \
  label.color=$FG_PRIMARY \
  label.padding_left=8 \
  label.padding_right=10 \
  background.drawing=off \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# Media
sketchybar --add item media left \
  --set media \
  update_freq=2 \
  icon.drawing=off \
  label.color=$FG_PRIMARY \
  label.font="Hack Nerd Font:Regular:12.0" \
  label.padding_left=8 \
  label.padding_right=8 \
  background.drawing=off \
  script="$PLUGIN_DIR/media.sh" \
  --subscribe media media_change

# ============================================================
# Right

# Date & Time
sketchybar --add item clock right \
  --set clock \
  update_freq=1 \
  icon.drawing=off \
  label.color=$FG_PRIMARY \
  label.font="Hack Nerd Font:Regular:12.0" \
  label.padding_left=8 \
  label.padding_right=8 \
  background.drawing=off \
  script="$PLUGIN_DIR/clock.sh"

# Volume
sketchybar --add item volume right \
  --set volume \
  icon.drawing=off \
  label.color=$FG_PRIMARY \
  label.font="Hack Nerd Font:Regular:12.0" \
  label.padding_left=8 \
  label.padding_right=8 \
  background.drawing=off \
  script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

# Battery
sketchybar --add item battery right \
  --set battery \
  update_freq=120 \
  icon.drawing=off \
  label.color=$FG_PRIMARY \
  label.font="Hack Nerd Font:Regular:12.0" \
  label.padding_left=8 \
  label.padding_right=8 \
  background.drawing=off \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

# Wifi
sketchybar --add item wifi right \
  --set wifi \
  update_freq=10 \
  icon.drawing=off \
  label.color=$FG_PRIMARY \
  label.font="Hack Nerd Font:Regular:12.0" \
  label.padding_left=6 \
  label.padding_right=6 \
  label.align=center \
  background.drawing=off \
  script="$PLUGIN_DIR/wifi.sh" \
  --subscribe wifi wifi_change

# Bluetooth
sketchybar --add item bluetooth right \
  --set bluetooth \
  update_freq=30 \
  icon.drawing=off \
  label.color=$FG_PRIMARY \
  label.font="Hack Nerd Font:Regular:12.0" \
  label.padding_left=8 \
  label.padding_right=8 \
  background.drawing=off \
  script="$PLUGIN_DIR/bluetooth.sh" \
  --subscribe bluetooth system_woke

##### Island Containers (3 total) #####
sketchybar --add bracket island.left \
  apple.logo apple.separator aerospace.lbracket aerospace.active aerospace.sep aerospace.occupied aerospace.rbracket front_app media \
  --set island.left \
  background.drawing=on \
  background.color=$BG_CARD \
  background.corner_radius=0 \
  background.border_width=1 \
  background.border_color=$BORDER \
  background.height=28 \
  background.padding_left=6 \
  background.padding_right=6

sketchybar --add bracket island.right \
  clock volume battery wifi bluetooth \
  --set island.right \
  background.drawing=on \
  background.color=$BG_CARD \
  background.corner_radius=0 \
  background.border_width=1 \
  background.border_color=$BORDER \
  background.height=28 \
  background.padding_left=6 \
  background.padding_right=6

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
