{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": " ",
    "color": "38;2;200;200;255",
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 2,
      "right": 4,
      "left": 2,
    },
    "color": {
      "1": "38;2;137;180;250", // Blue
      "2": "38;2;166;227;161", // Green
      "3": "38;2;249;226;175", // Yellow
      "4": "38;2;245;194;231", // Pink
      "5": "38;2;203;166;247", // Purple
      "6": "38;2;148;226;213", // Teal
    },
  },
  "modules": [
    {
      "type": "title",
      "keyColor": "38;2;245;194;231",
    },
    {
      "type": "custom",
      "format": "────────────────────────────────────────",
    },
    {
      "type": "os",
      "key": "󰀵 os\t    ",
      "keyColor": "38;2;137;180;250",
    },
    {
      "type": "uptime",
      "key": "󰅐 uptime  ",
      "keyColor": "38;2;245;194;231",
    },
    {
      "type": "cpu",
      "key": " cpu\t    ",
      "keyColor": "38;2;249;226;175",
    },
    {
      "type": "memory",
      "key": "󰍛 memory  ",
      "keyColor": "38;2;148;226;213",
    },
    {
      "type": "custom",
      "format": "────────────────────────────────────────",
    },
    {
      "type": "colors",
      "symbol": "diamond",
      "keyColor": "38;2;137;180;250",
    },
  ],
}
